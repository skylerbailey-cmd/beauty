{
  "expo": {
    "name": "SkySale",
    "slug": "skysale",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skysale",
    "backgroundColor": "#FDF6F0",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FDF6F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skysale.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF6F0"
      },
      "package": "com.skysale.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4A0A0",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "SkySale"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b55a1150-e57e-4ad8-a49f-a434aaccba21"
      }
    }
  }
}
